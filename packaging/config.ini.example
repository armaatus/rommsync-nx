; rommsync-nx -- sdmc:/config/rommsync/config.ini
;
; Copy this file to config.ini beside it and edit it. The client only ever
; reads config.ini; this .example is what an upgrade replaces, so your own
; settings are never overwritten by unzipping a newer release over the top.
;
; Every key below is already at its built-in default except [server] url, which
; has none -- without a usable one the client stays idle. Deleting a line is
; therefore safe: the default comes back. The full reference, including the
; folder map and what happens to a line the parser cannot use, is
; docs/CONFIG.md.

; The format this file is written in, not the client's version. Leave it as it
; is: only a release that changes what a key means moves it (docs/CONFIG.md,
; "Version"), and an older sysmodule refuses a file from a newer release rather
; than misreading it.
version = 1

[server]
; The RomM origin. HTTPS strongly recommended: over plain http:// the bearer
; token and every save cross your network in the clear. A path prefix is kept,
; so RomM behind a reverse proxy at /romm works.
url = https://romm.example.com

[sync]
enabled       = true
interval_min  = 30                 ; minutes; 0 = only on boot and on demand
on_boot       = true
saves         = true
states        = false              ; save states are core-specific; opt-in
conflict_show = true               ; surface conflicts in the overlay
; A save you deleted in RomM: remove takes it off the card, after backing it up
; under /config/rommsync/.backup/; keep leaves it here and never uploads it.
on_server_delete = remove

[downloads]
enabled     = true
verify_hash = true                 ; check the hash after a download
resume      = true

[sources]
; RetroArch's folders are read from sdmc:/retroarch/retroarch.cfg, sorted by
; core or not, as RetroArch is set up. auto leaves them alone while RetroArch's
; own Cloud Sync is on ("RetroArch syncs itself"); on reads them anyway; off
; never reads them.
retroarch             = auto
; RetroArch can keep saves beside the roms (savefiles_in_content_dir). Those
; folders hold roms, so they are read only when this is true.
retroarch_content_dir = false

[tico]
; Tico 0.8 keeps saves per Switch account, under /tico/saves/users/<account>/.
; auto reads the one account there is, and asks (on the settings screen) when
; there are several; legacy always reads the layout before 0.8.0; or name the
; account by its 32-digit id, as its folder under users/ is named.
account = auto

; --- the platform folder map -------------------------------------------------
;
; A built-in map ships for the Switch-capable systems (nes, snes, gb, gbc, gba,
; n64, genesis, sms, gamegear, segacd, psx, nds, dc, dreamcast, psp, saturn,
; fbneo, arcade), in Tico's folder names (sms is /tico/roms/master-system), so
; this file only needs the ones you want to change. Uncomment a section to
; override that platform.
;
; gc, wii and 3ds are off by default. Turn one on with its built-in folders:
;
; [platform.ngc]
; enabled = true
;
; A [platform.<slug>] section REPLACES that platform's built-in entry rather
; than adding to it -- list every key you want it to have. The slug is RomM's
; platform_fs_slug, the directory name under its library/roms/.
;
; roms   = where downloads land; the FIRST entry is the write target
; saves  = directories scanned for SRAM saves
; states = directories scanned for save states
;
; emulator = the RomM emulator id this platform's saves are sent as, when the
;            built-in one is wrong -- say Tico runs GB on mGBA. A section with
;            only this key keeps the built-in folders. See docs/CONFIG.md.
;
; [platform.gb]
; emulator = mgba
;
; What the built-in map holds for two of them:
;
; [platform.snes]
; roms   = /tico/roms/snes
; saves  = /retroarch/saves, /tico/saves/snes
; states = /retroarch/states, /tico/states/snes
;
; [platform.gba]
; roms   = /tico/roms/gba
; saves  = /retroarch/saves, /tico/saves/gba
; states = /retroarch/states, /tico/states/gba
