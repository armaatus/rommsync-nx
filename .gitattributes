# Normalize line endings: LF in the repo, auto on checkout.
* text=auto eol=lf

# Explicit text types (Switch homebrew + server tooling).
*.c      text
*.h      text
*.cpp    text
*.hpp    text
*.py     text
*.md     text
*.json   text
*.ini    text
*.sh     text eol=lf
Makefile text

# Binary assets — never touch line endings or try to diff/merge.
*.png    binary
*.jpg    binary
*.ico    binary
*.nsp    binary
*.nso    binary
*.nro    binary
*.ovl    binary
*.elf    binary
*.bin    binary
