{
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)",
      "Bash(gh issue view:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)",
      "Bash(./scripts/fleet/env.sh:*)",
      "Bash(./scripts/fleet/fleet.sh:*)",
      "Bash(./scripts/fleet/stop.sh:*)",
      "Bash(./scripts/fleet/reap.sh:*)",
      "Bash(./scripts/fleet/await-review.sh:*)",
      "Bash(./scripts/fleet/issue-command.sh:*)",
      "Bash(python3 .github/scripts/merge_gate.py:*)",
      "Bash(orca worktree set:*)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(./evals/lint.sh:*)",
      "Bash(./scripts/orca/compose.sh:*)",
      "Bash(./scripts/orca/env.sh:*)",
      "Bash(./scripts/orca/tls-fixture.sh:*)",
      "Bash(./server/testing/seed.sh:*)",
      "Bash(git submodule add https://github.com/ppkantorski/libultrahand:*)",
      "Bash(git submodule add https://github.com/ppkantorski/Ultrahand-Overlay:*)",
      "Bash(git submodule add https://github.com/ppkantorski/ovl-sysmodules:*)",
      "Bash(git submodule update:*)",
      "Bash(git submodule init:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell-parses.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
