{
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(plans/**)",
      "Write(plans/**)",
      "Edit(evals/**)",
      "Write(evals/**)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(./evals/lint.sh:*)",
      "Bash(./scripts/orca/compose.sh:*)",
      "Bash(./scripts/orca/env.sh:*)",
      "Bash(./scripts/orca/romm-logs.sh:*)",
      "Bash(./scripts/orca/romm-browser.sh:*)",
      "Bash(./server/testing/seed.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shellcheck-edited.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
