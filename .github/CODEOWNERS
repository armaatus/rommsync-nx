# Code owners for rommsync-nx.
# These owners are requested for review automatically on matching PRs.
# Docs: https://docs.github.com/articles/about-code-owners

# Default owner for everything in the repo.
*                   @armaatus

# Security-sensitive surfaces — auth, sync protocol, token handling, policy.
/SECURITY.md        @armaatus
/docs/SECURITY.md   @armaatus
/docs/AUTH.md       @armaatus
/docs/SYNC_PROTOCOL.md @armaatus
/docs/API_CONTRACT.md  @armaatus
/.github/           @armaatus

# Code that EXECUTES on a maintainer's machine when a worktree is created.
# Orca hashes only the command strings in orca.yaml for its trust prompt, not
# the contents of the scripts those strings invoke — so a change to a script
# here runs without any re-confirmation. Both paths are listed: orca.yaml
# decides what runs, scripts/orca/ decides what it does. Review accordingly.
/orca.yaml          @armaatus
/scripts/orca/      @armaatus

# Invoked by the setup hook above, so it inherits the same exposure.
/server/testing/    @armaatus
