# secrets / per-user state — never commit
config.ini
# ...and the .tmp/.old an interrupted commit leaves beside it, which hold the
# same bearer token and which a bare `token.dat` line does not match.
token.dat*
device.dat*
*.token
.env
.env.tmp*

# generated per-worktree environment / fixtures — never shared, never committed
.cache/
server/testing/library/
server/testing/fixture-auth.env
.venv/
.orca/
TASK.md

# build output
build/
build-*/
*.o
*.elf
*.nso
*.nsp
*.npdm
*.ovl
*.nro
*.nacp
*.map
*.lst

# python (server/)
__pycache__/
*.pyc

# editor / os
.vscode/
.idea/
.DS_Store
