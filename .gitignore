# secrets / per-user state — never commit
config.ini
# ...and the .tmp/.old an interrupted commit leaves beside it, which hold the
# same bearer token and which a bare `token.dat` line does not match.
token.dat*
device.dat*
*.token
.env
.env.tmp*

# the fixture TLS certificate and its private key: minted per worktree by
# scripts/orca/tls-fixture.sh, throwaway, and still a private key
server/testing/tls/generated/

# generated per-worktree environment / fixtures — never shared, never committed
.cache/
server/testing/library/
server/testing/fixture-auth.env
.venv/
.orca/
TASK.md

# build output
build/
build-*/
*.o
*.elf
*.nso
*.nsp
*.npdm
*.ovl
*.nro
*.nacp
*.map
*.lst

# python (server/)
__pycache__/
*.pyc

# editor / os
.vscode/
.idea/
.DS_Store

# Claude Code configuration: an allowlist, because the default has to be private.
#
# The committed half IS the shared workflow -- the skills, the subagents, the
# hooks and the settings that register them steer every agent in every worktree,
# and they are reviewed like code (see evals/). Everything else under .claude/ is
# per-session or per-person: settings.local.json is the personal override, and a
# worktree-scoped permission mode is exactly what must not leak into someone
# else's checkout.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/skills/
!.claude/settings.json
